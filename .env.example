# Deriv Credentials
DERIV_APP_ID=your_deriv_app_id_here
DERIV_API_TOKEN=your_deriv_api_token_here

# LLM Providers
GROQ_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
MISTRAL_API_KEY_1=your_mistral_api_key_1_here
MISTRAL_API_KEY_2=your_mistral_api_key_2_here

# Supabase Credentials
SUPABASE_URL=your_supabase_url_here
# IMPORTANT: For the backend, this MUST be the `service_role` key (not the anon key) to bypass RLS policies
SUPABASE_KEY=your_supabase_service_role_key_here

# Trading and Risk Parameters
TRADING_ENABLED=false
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=50.0
MAX_OPEN_TRADES=3

# Application Settings
LOOP_INTERVAL_SECONDS=3600
PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD
SYNTHETIC_INSTRUMENTS=R_75,R_100,BOOM1000,CRASH1000
